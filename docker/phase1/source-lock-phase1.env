# Pinned inputs for the Phase 1 image. Sourced by shell scripts; keep values shell-safe.

BASE_IMAGE_REF=ubuntu:26.04
UBUNTU_CODENAME=resolute
ROS_DISTRO_LOCK=lyrical
RMW_IMPLEMENTATION_LOCK=rmw_fastrtps_cpp
PYTHON_TAG=cp314

# Flexiv ROS 2 driver fork; provides cartesian_motion_controller, flexiv_robot_states_broadcaster and rizon_cartesian.launch.py.
FLEXIV_ROS2_REPOSITORY=https://github.com/NVIDIA-ISAAC-ROS/flexiv_ros2.git
FLEXIV_ROS2_COMMIT=89482be64718e161ce2752ce644a5da045ae10ac
# Flexiv RDK v1.9.4 (tag commit). Must match the robot firmware; a mismatch fails at connect
# with "Version of this client is incompatible with robot".
# The build verifies the downloaded library against the checksum in the RDK repo.
FLEXIV_RDK_COMMIT=fe5ee8734e8d0711bb6a60b24634d725c1e2facd

# PyTorch cu130 wheels (from the PyTorch index, not PyPI).
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
TORCH_VERSION=2.13.0+cu130

# rsl_rl 3.x: the checkpoint loader in rsl_rl_runtime.py depends on the 3.x ActorCritic API.
RSL_RL_VERSION=3.1.2

# Required by rsl-rl-lib (unused at inference). From PyPI rather than apt:
# Ubuntu's python3-git lags the security fixes (>= 3.1.59 needed).
GITPYTHON_VERSION=3.2.1

# librealsense Python bindings.
PYREALSENSE2_VERSION=2.58.3.10794
