# Pinned inputs for the Phase 2 image, layered on the Phase 1 image.

BASE_IMAGE_REF=sparr-phase1:latest
PYTHON_TAG=cp314

# JAX; the cuda13 extra pulls plugin/pjrt packages that must match the jax/jaxlib version.
JAX_VERSION=0.11.1
JAX_CUDA_EXTRA=cuda13

# Residual RL stack. flax 0.12 still ships FrozenDict, which serl_launcher requires.
FLAX_VERSION=0.12.9
DISTRAX_VERSION=0.1.9
OPTAX_VERSION=0.2.8
CHEX_VERSION=0.1.92
ORBAX_CHECKPOINT_VERSION=0.12.4

# Runtime imports of serl_launcher / agentlace; matplotlib is for tools/sparr_failure_analysis.py.
EINOPS_VERSION=0.8.2
GYMNASIUM_VERSION=1.3.0
MATPLOTLIB_VERSION=3.11.1
LZ4_VERSION=4.4.5
PYZMQ_VERSION=27.2.0
# Needed by torch.utils.tensorboard for learner training curves.
TENSORBOARD_VERSION=2.21.0

# Vendored sources, put on PYTHONPATH rather than pip-installed (see Dockerfile.phase2).
SERL_LAUNCHER_PATH=serl_launcher
AGENTLACE_PATH=agentlace
AGENTLACE_UPSTREAM_COMMIT=cf2c337c5e3694cdbfc14831b239bd657bc4894d

# Pretrained ResNet-10 encoder baked into the image.
RESNET10_URL=https://github.com/rail-berkeley/serl/releases/download/resnet10/resnet10_params.pkl
RESNET10_SHA256=175745d43d30233eb01b5369465d1c24c11b8ee71ccb734cc1c1bca13e07f57b
