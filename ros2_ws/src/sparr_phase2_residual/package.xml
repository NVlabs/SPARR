<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sparr_phase2_residual</name>
  <version>0.1.0</version>
  <description>SPARR Phase 2 residual training and inference for a Flexiv Rizon.</description>
  <maintainer email="sparr-maintainers@example.com">SPARR Maintainers</maintainer>
  <license>NVIDIA License</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-h5py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>sparr_phase1_collection</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
